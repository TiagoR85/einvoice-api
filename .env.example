# PostgreSQL
POSTGRES_USER=einvoice
POSTGRES_PASSWORD=
POSTGRES_DB=einvoice

# OIDC client secret used by einvoice-api to seed the OpenIddict client
OIDC_CLIENT_SECRET=

# OIDC secret for the read-only einvoice-worker client (worker OAuth)
OIDC_WORKER_CLIENT_SECRET=

# RabbitMQ (defaults work for local demo)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# API environment
ASPNETCORE_ENVIRONMENT=Production
